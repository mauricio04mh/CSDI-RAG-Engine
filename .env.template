# Runtime
APP_ENV=development
APP_PORT=8888
LOG_LEVEL=INFO
PYTHONPATH=.

# Database / cache
# Use port 5444 when connecting from the host through docker compose.
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5444/ragengine
REDIS_URL=redis://localhost:6379/0
CHAT_HISTORY_TTL_SECONDS=604800
POSTGRES_PORT=5444
REDIS_PORT=6379

# Indexing
INDEX_BUFFER_SIZE=10000
INDEX_MAX_SEGMENTS_IN_MEMORY=5
INDEX_FLUSH_INTERVAL=30

# BM25 retrieval
BM25_K1=1.5
BM25_B=0.75

# Vector indexing
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DIMENSION=1024
FAISS_INDEX_TYPE=HNSW
HNSW_M=32
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=50
VECTOR_BATCH_SIZE=64
QUERY_PREFIX=
FAISS_INDEX_PATH=

# Hybrid search
# These weights must sum to 1.0.
HYBRID_BM25_WEIGHT=0.3
HYBRID_VECTOR_WEIGHT=0.7

# LLM / RAG
# OpenAI-compatible endpoint: works with providers like Mistral, Groq, OpenAI, Together AI, or local gateways.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-small-latest
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_CONTEXT_CHUNKS=15
LLM_TIMEOUT=60.0

# Re-ranker
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_K=30

# HyDE query expansion
HYDE_ENABLED=false

# Web search/cache
WEB_CACHE_ENABLED=true
WEB_CACHE_TOP_K=10
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TOP_K=5

# Insufficiency detector
INSUFF_MIN_RESULTS=5
INSUFF_EXPECTED_RESULTS=10
INSUFF_MIN_TOP_SCORE=0.35
INSUFF_RELEVANT_OVERLAP_THRESHOLD=0.60
INSUFF_MIN_RELEVANT_RESULTS=2
INSUFF_MIN_COVERAGE_SCORE=0.20
INSUFF_MIN_ANSWERABILITY_SCORE=0.40
INSUFF_MIN_SOURCE_DIVERSITY=0.30
INSUFF_CONFIDENCE_THRESHOLD=0.65
INSUFF_COVERAGE_TOP_N=5
INSUFF_W_TOP=0.10
INSUFF_W_QUANTITY=0.15
INSUFF_W_COVERAGE=0.35
INSUFF_W_DIVERSITY=0.15
INSUFF_W_ANSWERABILITY=0.25

# Persisted API config
PIPELINE_CONFIG_PATH=pipeline_config.json
QUERY_FEEDBACK_COMPARISON_PROBABILITY=0.25

# Reserved/local paths. These are present in some local env files, but the current code mostly relies on DB persistence.
INDEX_SEGMENT_PATH=./index/segments
BM25_INDEX_PATH=./index/segments
VECTOR_INDEX_PATH=./vector_index
INDEX_COMPRESSION=false
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
