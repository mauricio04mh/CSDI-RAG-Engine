# Core
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragengine
LOG_LEVEL=INFO

# Indexing
INDEX_BUFFER_SIZE=10000
INDEX_MAX_SEGMENTS_IN_MEMORY=5
INDEX_FLUSH_INTERVAL=30
BM25_K1=1.5
BM25_B=0.75

# Vector indexing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384
FAISS_INDEX_TYPE=HNSW
HNSW_M=32
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=50
VECTOR_BATCH_SIZE=128

# Hybrid search
HYBRID_BM25_WEIGHT=0.3
HYBRID_VECTOR_WEIGHT=0.7

# LLM / RAG
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_CONTEXT_CHUNKS=15
LLM_TIMEOUT=60.0
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_K=30

# Persisted pipeline config
PIPELINE_CONFIG_PATH=pipeline_config.json
